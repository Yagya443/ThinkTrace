# Copy to backend/.env
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Any model you have pulled in Ollama, e.g. gemma3:4b, gemma3:12b, qwen2.5:7b
AI_MODEL=gemma3:4b
AI_TIMEOUT_MS=60000

# Optional: raises GitHub API rate limits for profile import. Never required.
# GITHUB_TOKEN=
